# 不用 Docker 时的 systemd 服务（Ubuntu / Debian）。用法见 README“直接装在服务器上”。
[Unit]
Description=未央 Agent 版
After=network-online.target
Wants=network-online.target

[Service]
User=weiyang
WorkingDirectory=/opt/weiyang-agent
# 密码和密钥写在这个文件里（权限 600，只有 root 和 weiyang 能读）
EnvironmentFile=/etc/weiyang-agent.env
Environment=DATA_DIR=/var/lib/weiyang-agent HOST=127.0.0.1 PORT=8787 NODE_ENV=production
ExecStart=/usr/bin/node server/main.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/weiyang-agent

[Install]
WantedBy=multi-user.target
