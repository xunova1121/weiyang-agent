{
  "name": "weiyang-agent-desktop",
  "productName": "未央",
  "version": "1.0.0",
  "description": "未央 Agent 版的 Windows 程序：一个连你自己服务器的窗口（托盘、通知、开机自启、自动更新）",
  "main": "main.cjs",
  "private": true,
  "author": "xunova1121",
  "scripts": {
    "sync": "node -e \"require('fs').copyFileSync('../shell.json','shell.json')\"",
    "prestart": "npm run sync",
    "start": "electron .",
    "predist": "npm run sync",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.xunova.weiyang2",
    "productName": "未央",
    "artifactName": "WeiyangAgent-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "shell.json",
      "build/icon.png"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "未央"
    },
    "publish": {
      "provider": "github",
      "owner": "xunova1121",
      "repo": "weiyang-agent",
      "releaseType": "release"
    }
  }
}
